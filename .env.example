# NutriPalm AI -- frontend environment (Vite). Copy to `.env.local` and fill in.
# Only VITE_* variables reach the browser; never put secrets here.

# Supabase project (Dashboard -> Project Settings -> API).
# Use the project URL (no trailing slash, no /rest/v1) and the PUBLIC anon key.
# Never use the service-role key in the frontend.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# FastAPI backend. For local development this defaults to http://localhost:8000
# when unset. A production build with this unset uses same-origin URLs (/api/...),
# e.g. behind a reverse proxy.
VITE_API_BASE_URL=http://localhost:8000

# OPTIONAL: Google Maps JavaScript API key for the satellite boundary surveyor.
# Without it the surveyor uses the built-in Esri satellite / Leaflet engine.
# Restrict the key by HTTP referrer in Google Cloud. See docs/GOOGLE_MAPS_SETUP.md.
VITE_GOOGLE_MAPS_API_KEY=
