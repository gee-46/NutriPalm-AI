# NutriPalm AI -- frontend environment (Vite). Copy to `.env.local` and fill in.
# Only VITE_* variables reach the browser; never put secrets here.

# Supabase project (Dashboard -> Project Settings -> API).
# Use the project URL (no trailing slash, no /rest/v1) and the PUBLIC anon key.
# Never use the service-role key in the frontend.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# FastAPI backend. For local development this defaults to http://localhost:8000
# when unset. A production build with this unset uses same-origin URLs (/api/...),
# e.g. behind a reverse proxy.
VITE_API_BASE_URL=http://localhost:8000

# Satellite imagery for the boundary survey and plot maps (Leaflet). ONE provider, configured explicitly; there is no fallback.
# With nothing set, development builds use Esri World Imagery. A PRODUCTION build loads NO imagery until the site owner has
# verified the provider's terms for this deployment and set VITE_MAP_LICENSE_CONFIRMED=true. See docs/MAPS_AND_LOCATION.md.
# Esri's terms for items it owns require use "in conjunction with Esri software or an ArcGIS Online subscription" (plain Leaflet
# is not Esri software): confirm your licence with Esri, or configure a provider whose terms you have accepted below.
VITE_MAP_LICENSE_CONFIRMED=
# To use a different provider (all required together; the key, if any, is a PUBLIC referrer-restricted key, never a secret):
# VITE_MAP_TILE_URL=https://tiles.example.org/imagery/{z}/{x}/{y}.jpg?key={apiKey}
# VITE_MAP_API_KEY=
# VITE_MAP_PROVIDER_NAME=Example Imagery
# VITE_MAP_ATTRIBUTION=(c) Example Imagery and its data providers
# VITE_MAP_MAX_NATIVE_ZOOM=18

# NOTE: server-side values (SUPABASE_SERVICE_ROLE_KEY, SUPABASE_JWT_SECRET, SENTINEL_HUB_*) must NEVER be put in this
# file or in any VITE_* variable. They belong in backend/.env (see backend/.env.example).
