# Copy to backend/.env and fill in real values. Never commit the real .env file.

# --- Supabase (server-side only - NEVER expose these to the frontend) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Used to verify the Supabase Auth JWT sent by the frontend. Find this in
# Supabase Dashboard -> Project Settings -> API -> JWT Secret.
# (If your project uses the newer asymmetric JWT signing keys instead of a
# shared HS256 secret, see the note in backend/app/dependencies.py.)
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# --- App ---
ENVIRONMENT=development
CORS_ALLOW_ORIGINS=http://localhost:5173
STRICT_NO_MOCK_DATA=true

# --- Satellite / Sentinel-2 NDVI (Sentinel Hub) ---
# Create a free/trial OAuth client at https://apps.sentinel-hub.com
# (Dashboard -> User settings -> OAuth clients).
# Used by:
#   - GET /api/geospatial/ndvi/{plot_id}          (on-demand, real-time NDVI)
#   - app/services/satellite_ingestion_service.py  (historical backfill via
#     backend/scripts/ingest_real_data.py)
# If left unset, NDVI features report available=false / are skipped rather
# than fabricating values.
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# --- OCR / Binary System Paths (Optional Overrides) ---
# On Linux/Debian, these are typically on PATH via system packages (poppler-utils, tesseract-ocr).
# On Windows, the app auto-detects common locations (WinGet, Desktop, Program Files),
# but you can explicitly specify the paths here if installed in a custom directory.
# POPPLER_PATH=C:\Program Files\poppler\Library\bin
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

