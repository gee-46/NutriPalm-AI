# NutriPalm AI -- backend environment. Copy to backend/.env (never commit it).

# --- Supabase (server-side only; NEVER expose these to the frontend) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Token verification. Use ONE of the following, matching your project's signing mode:
#  * Legacy HS256 projects: the JWT secret (Dashboard -> Project Settings -> API).
#  * Asymmetric (RS256/ES256) projects: the JWKS URL (derived from SUPABASE_URL if blank).
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=

# --- App ---
# development | staging | production. In staging/production STRICT_NO_MOCK_DATA must
# stay true and CORS_ALLOW_ORIGINS must list explicit origins (no "*").
ENVIRONMENT=development
# Comma-separated list of allowed browser origins.
CORS_ALLOW_ORIGINS=http://localhost:5173
STRICT_NO_MOCK_DATA=true

# --- Sentinel Hub / Sentinel-2 NDVI (optional) ---
# Create an OAuth client at https://apps.sentinel-hub.com (User settings -> OAuth clients).
# If left blank the NDVI endpoint reports available=false; nothing is fabricated.
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# --- OCR system binaries (optional overrides) ---
# Soil-report OCR needs the Tesseract and Poppler binaries installed on the machine.
# On Linux they are normally on PATH (apt-get install tesseract-ocr poppler-utils).
# On Windows set the paths if they are not auto-detected:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# POPPLER_PATH=C:\path\to\poppler\Library\bin
