{
  "name": "nutripalm-db-verification",
  "private": true,
  "type": "module",
  "description": "Repeatable migration + RLS verification on a throwaway Postgres (PGlite). Not part of the app bundle.",
  "scripts": {
    "verify": "node verify.mjs",
    "verify:remote": "node verify-remote.mjs",
    "e2e": "node e2e/run.mjs",
    "e2e:stack-selftest": "node e2e-stack/selftest.mjs",
    "verify:upgrade": "node verify-upgrade.mjs",
    "smoke:staging": "node staging-smoke.mjs",
    "smoke:selftest": "node staging-smoke.mjs --selftest",
    "e2e:pipeline": "node e2e/pipeline.mjs",
    "e2e:survey": "node e2e/survey.mjs",
    "e2e:kn-typography": "node e2e/kn-typography.mjs --compare"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "playwright-core": "^1.64.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2"
  }
}
